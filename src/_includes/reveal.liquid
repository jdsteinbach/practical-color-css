<!doctype html>
<html>

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

  <title>{{ slides.title }}</title>
  <meta name="description" content="{{ slides.description }}">

  <link rel="stylesheet" href="reveal/reset.css">
  <link rel="stylesheet" href="reveal/reveal.css">
  <link rel="stylesheet" href="css/theme/custom.css">
</head>

<body class="">
  <div class="reveal">
    <div class="slides">
      {% for slide in collections.slides %}
      {% include "_section" %}
      {% endfor %}
    </div>

    <footer class="colophon">
      <div class="colophon__logo">
        {% include "_colophon-logo" %}
      </div>

      <a href="{{ slides.public_url }}" class="colophon__link">{{ slides.short_url }}</a>
    </footer>
  </div>

  <script type="module">
    import Reveal from './reveal/reveal.mjs'

    const scale = .9

    const deck = new Reveal({
      height: 1080 * 1 * scale,
      width: 1920 * 0.95 * scale,
      hash: true,
      transition: 'fade'
    });
    deck.initialize();
  </script>
</body>

</html>
